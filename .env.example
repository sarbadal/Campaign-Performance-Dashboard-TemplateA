# App behavior
SECRET_KEY=replace-with-a-long-random-secret
APP_PASSWORD=change-me-now
ENV_TYPE=dev
# Example GCS bucket name used for prod static hosting
STATIC_BUCKET=my-campaign-dashboard-assets
# Optional full base URL (preferred in prod when set), for example a CDN domain or GCS URL
STATIC_BASE_URL=https://storage.googleapis.com/my-campaign-dashboard-assets
KPI_CACHE_TTL_SECONDS=300

# Deployment defaults for deployment.py (optional CLI override)
DEPLOY_PROJECT_ID=
DEPLOY_REGION=us-central1
DEPLOY_FUNCTION_NAME=campaign-performance-template-a
DEPLOY_ENTRY_POINT=entry_point
DEPLOY_RUNTIME=python312
DEPLOY_BUCKET_NAME=
DEPLOY_BUCKET_LOCATION=US
DEPLOY_STATIC_DIR=backend/static
DEPLOY_SOURCE_DIR=.
DEPLOY_ALLOW_UNAUTHENTICATED=true
# Database backend selector:
# - sqlite: uses SQLITE_DB_FILE
# - mysql: uses MYSQL_* settings
# If both sqlite and mysql settings are present, only DB_BACKEND is used.
# Valid values: sqlite | mysql
DB_BACKEND=sqlite
SQLITE_DB_FILE=data/campaign_performance.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campaign_performance
MYSQL_TABLE=campaign_data
MYSQL_STATE_TABLE=ingestion_state

# GCS data bucket and prefix for reading data files (used when DB_BACKEND=gcs)
GCS_DATA_BUCKET=campaign-performance-template-a
GCS_DATA_PREFIX=data.sample.monthly

DASHBOARD_SETTINGS_FILE=settings/dashboard_settings.json
FIELD_MAPPING_FILE=settings/field_mapping.json
KPI_CURRENCY_SYMBOL=RM

# Branding
CLIENT_NAME=Acme Beverages
DASHBOARD_KICKER=Client Dashboard
DASHBOARD_BANNER_TITLE=Campaign Performance Executive Snapshot

# Place your real logo image under backend/static/img/ and set the relative path below.
# Supported by browser: png, jpg, jpeg, svg, webp
LOGO_IMAGE_PATH=img/client-logo.png

# Banner style
BANNER_GRADIENT_START=#0b6e4f
BANNER_GRADIENT_MID=#13795c
BANNER_GRADIENT_END=#2e8f74

# Font stack used across dashboard
DASHBOARD_FONT_FAMILY='"Georgia", "Times New Roman", serif'

# KPI card style
KPI_LABEL_COLOR=#56605b
KPI_VALUE_COLOR=#0b6e4f
KPI_LABEL_FONT_SIZE=0.9rem
KPI_VALUE_FONT_SIZE=1.8rem

# Footer
FOOTER_TEAM_NAME=Performance Analytics Team
FOOTER_RIGHT_TEXT=Generated from source system
